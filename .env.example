# Copy this file to `.env.local` (git-ignored) and fill in your Supabase project values.
# Find them in the Supabase dashboard → Project Settings → API Keys / Data API.
# The publishable key is safe to ship in the app; never put a secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
